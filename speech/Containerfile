FROM docker.io/oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS build
WORKDIR /app/speech
COPY speech/package.json speech/bun.lock ./
RUN bun install --frozen-lockfile
COPY speech/src ./src
COPY speech/build.ts ./build.ts
COPY speech/THIRD_PARTY_NOTICES.md ./THIRD_PARTY_NOTICES.md
COPY plugin/src/speech-contract.ts /app/plugin/src/speech-contract.ts
# Shared contract resolution without installing OpenCode/plugin dependencies.
RUN ln -s /app/speech/node_modules /app/plugin/node_modules
RUN bun run build

FROM docker.io/library/debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/speech/dist/voxpilot-speech /usr/local/bin/voxpilot-speech
COPY --from=build /app/speech/dist/THIRD_PARTY_NOTICES.md /usr/share/doc/voxpilot-speech/THIRD_PARTY_NOTICES.md
USER 65532:65532
ENV SPEECH_HOST=0.0.0.0 SPEECH_PORT=8789
EXPOSE 8789
ENTRYPOINT ["/usr/local/bin/voxpilot-speech"]
