[Unit]
Description=VoxPilot tsnet HTTPS proxy (Tailscale)
After=network-online.target voxpilot.service
Wants=network-online.target
BindsTo=voxpilot.service

[Service]
Type=simple
WorkingDirectory=%h/.local/share/voxpilot
EnvironmentFile=-%h/.config/voxpilot/tsnet.env
ExecStart=%h/.local/share/voxpilot/tsnet-proxy
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Default tsnet state dir; override via TS_STATE_DIR in tsnet.env if desired.
Environment=TS_STATE_DIR=%h/.local/state/voxpilot-tsnet
Environment=PROXY_TARGET=http://127.0.0.1:8000

[Install]
WantedBy=default.target
