# For local development (just dev). Providers belong in OpenCode config.
OPENCODE_PASSWORD=development-only
# Deployment uses ~/.config/voxpilot/service.env instead of this file.
# VOXPILOT_HOSTNAME=0.0.0.0
# VOXPILOT_PORT=8000
# Optional additional origin; the standard lasath.com origins are built in.
# VOXPILOT_ORIGIN=https://voxpilot.apps.example.com
# VOXPILOT_WAKE_URL=https://your-home-assistant-webhook
