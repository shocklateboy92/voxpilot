# Models and credentials belong in OpenCode's own configuration.
# Private OpenCode HTTP port; 0 selects a free port.
VOXPILOT_OC_PORT=0
# Direct LAN clients authenticate as user "opencode" with this password.
VOXPILOT_OC_PASSWORD=abc123
# just dev sets VOXPILOT_PORT=8001; standalone defaults to 8000.
